# ============================================================
# STOCK PREDICTION PROJECT - .gitignore (FIXED)
# Fixes: `data/` + `!data/.gitkeep` cannot work (git never re-includes a file inside an
# ignored directory) -> use `dir/*`. Removed `requirements.txt`/`pyproject.toml` ignores,
# the `!streamlit/secrets.toml` line (would un-ignore a secrets file), the `.gitattributes`
# ignore, and the *.ipynb ignore. Added cache/, dashboard_data/, reports/.
# ============================================================

# ---------- Generated data / models / outputs ----------
data/*
!data/.gitkeep
cache/
dashboard_data/
models/*
!models/.gitkeep
!models/README.md
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
reports/
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
*.whl

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/
virtualenv/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
._*

# ---------- Secrets (never commit) ----------
.env
.env.*
*.env
.streamlit/secrets.toml
credentials.json
secrets.json
config.ini
api_keys.txt
secrets.txt
*.key
*.pem
*.p12
*.pfx
*.secret

# ---------- Testing / coverage ----------
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/

# ---------- Large / binary model artifacts ----------
*.pkl
*.joblib
*.h5
*.keras
*.pb
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors

# ---------- Archives / temp / backups ----------
*.zip
*.tar
*.tar.gz
*.gz
*.7z
*.rar
*.tmp
*.temp
*.bak
*.bak_*
*.backup
*.old
downloads/
tmp/
temp/
.cache/
.plotly/